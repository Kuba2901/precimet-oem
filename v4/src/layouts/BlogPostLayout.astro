---
import BaseLayout from './BaseLayout.astro';
import { path, type Locale } from '../i18n/config';
import { t } from '../i18n/ui';
import { dateFormatter, postSlug, type BlogPost } from '../lib/blog';

interface Props {
  locale: Locale;
  post: BlogPost;
}

const { locale, post } = Astro.props;
const dict = t(locale);
const fmt = dateFormatter(locale);
---

<BaseLayout
  locale={locale}
  title={`${post.data.title} — Precimet OEM Manufacturing`}
  description={post.data.description}
  pagePath={`/blog/${postSlug(post)}`}
  ogImage={post.data.cover}
>
  <article class="section post">
    <div class="container">
      <header class="post__head">
        <a class="post__back" href={path(locale, '/blog')}>← {dict.blog.backToList}</a>
        <p class="spec">
          {dict.blog.published}:
          <time datetime={post.data.date.toISOString()}>{fmt.format(post.data.date)}</time>
        </p>
        <h1>{post.data.title}</h1>
        {post.data.tags.length > 0 && (
          <ul class="post__tags" role="list">
            {post.data.tags.map((tag) => <li>{tag}</li>)}
          </ul>
        )}
      </header>

      {post.data.cover && (
        <figure class="post__cover">
          <img src={post.data.cover} alt="" width="1200" height="640" />
        </figure>
      )}

      <div class="prose">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .post__head { max-width: 46rem; margin-bottom: 2rem; }

  .post__back {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--c-red-500);
    margin-bottom: 1.5rem;
  }

  .post__back:hover { color: var(--c-red-600); }

  .post__head h1 { font-size: clamp(2rem, 4.6vw, 3.1rem); }

  .post__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .post__tags li {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-graphite-700);
    background: var(--c-sand-100);
    border: 1px solid var(--c-sand-300);
    border-radius: 999px;
    padding: 0.25rem 0.75rem;
  }

  .post__cover {
    margin: 0 0 2.25rem;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--c-line);
    max-width: 62rem;
  }

  .post__cover img {
    width: 100%;
    object-fit: cover;
    aspect-ratio: 2 / 1;
  }
</style>
