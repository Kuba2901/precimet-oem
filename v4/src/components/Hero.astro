---
import { path, type Locale } from '../i18n/config';
import { t } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const home = path(locale, '/');

// Stockowe zdjęcie hali / cięcia laserowego — podmień na własne przed publikacją
const heroImg =
  'https://images.unsplash.com/photo-1738162837438-92ff852619a1?q=80&w=3432&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D';
---

<section class="hero" style={`--hero-img: url('${heroImg}')`}>
  <div class="container hero__inner">
    <p class="eyebrow">{dict.hero.eyebrow}</p>
    <h1>
      {dict.hero.title1}<br />
      <span class="hero__accent">{dict.hero.titleAccent}</span><br />
      {dict.hero.title2}
    </h1>
    <p class="hero__lead">{dict.hero.lead}</p>

    <div class="hero__actions">
      <a class="btn btn--primary" href={`${home}#kontakt`}>{dict.hero.ctaPrimary}</a>
      <a class="btn btn--ghost-inverse" href={`${home}#kontakt`}>{dict.hero.ctaSecondary}</a>
    </div>

    <ul class="hero__chips" role="list">
      {dict.hero.chips.map((chip) => <li>{chip}</li>)}
    </ul>
  </div>

  <div class="hero__stats">
    <div class="container hero__stats-grid">
      {dict.hero.stats.map((s) => (
        <div class="stat">
          <strong>{s.value}</strong>
          <span class="spec">{s.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background:
      linear-gradient(100deg, rgb(30 33 36 / 0.95) 30%, rgb(30 33 36 / 0.72) 65%, rgb(30 33 36 / 0.55)),
      var(--hero-img) center / cover no-repeat;
    color: var(--c-text-inverse);
  }

  .hero__inner {
    padding-block: clamp(4.5rem, 11vw, 8.5rem) clamp(3rem, 7vw, 5rem);
    max-width: 780px;
  }

  h1 { color: #fff; margin-bottom: 1.1rem; }

  .hero__accent {
    color: var(--c-sand-500);
    position: relative;
  }

  /* czerwona "linia cięcia" pod akcentowanym wersem */
  .hero__accent::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0.06em;
    width: 100%;
    height: 3px;
    background: var(--c-red-500);
    opacity: 0.9;
  }

  .hero__lead {
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
    color: var(--c-text-inverse-muted);
    max-width: 56ch;
    margin-bottom: 1.8rem;
  }

  .hero__actions {
    display: flex;
    gap: 0.9rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }

  .hero__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .hero__chips li {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-sand-300);
    border: 1px solid rgb(207 200 150 / 0.4);
    border-radius: 999px;
    padding: 0.3rem 0.85rem;
  }

  .hero__stats {
    background: rgb(20 22 24 / 0.72);
    backdrop-filter: blur(4px);
    border-top: 1px solid rgb(207 200 150 / 0.25);
  }

  .hero__stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    padding-block: 1.4rem;
  }

  .stat {
    display: grid;
    gap: 0.15rem;
    border-left: 2px solid var(--c-red-500);
    padding-left: 0.9rem;
  }

  .stat strong {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    font-weight: 700;
    color: #fff;
    line-height: 1;
  }

  .stat .spec { color: var(--c-steel-300); font-size: 0.72rem; }

  @media (max-width: 820px) {
    .hero__stats-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 460px) {
    .hero__stats-grid { grid-template-columns: 1fr; }
  }
</style>
