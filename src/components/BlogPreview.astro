---
import { getCollection } from 'astro:content';
import { path, type Locale } from '../i18n/config';
import { t } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);

const posts = (await getCollection('blog', ({ data }) => data.lang === locale && !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const fmt = new Intl.DateTimeFormat(locale === 'pl' ? 'pl-PL' : locale === 'de' ? 'de-DE' : 'en-GB', {
  dateStyle: 'long',
});

const slugOf = (id: string) => id.replace(`${locale}/`, '');
---

<section id="blog" class="section">
  <div class="container">
    <header class="bp__head reveal">
      <div>
        <p class="eyebrow">{dict.blog.eyebrow}</p>
        <h2>{dict.blog.title}</h2>
        <hr class="laser-line" />
        <p class="bp__lead">{dict.blog.lead}</p>
      </div>
      <a class="btn btn--ghost" href={path(locale, '/blog')}>{dict.blog.all}</a>
    </header>

    {posts.length === 0 ? (
      <p>{dict.blog.empty}</p>
    ) : (
      <div class="bp__grid">
        {posts.map((post) => (
          <article class="card bp__card reveal">
            {post.data.cover && (
              <a href={path(locale, `/blog/${slugOf(post.id)}`)} class="bp__media" tabindex="-1">
                <img src={post.data.cover} alt={post.data.title} loading="lazy" width="600" height="380" />
              </a>
            )}
            <div class="bp__body">
              <time class="spec" datetime={post.data.date.toISOString()}>
                {fmt.format(post.data.date)}
              </time>
              <h3>
                <a href={path(locale, `/blog/${slugOf(post.id)}`)}>{post.data.title}</a>
              </h3>
              <p>{post.data.description}</p>
              <a class="bp__more" href={path(locale, `/blog/${slugOf(post.id)}`)}>
                {dict.blog.readMore} →
              </a>
            </div>
          </article>
        ))}
      </div>
    )}
  </div>
</section>

<style>
  .bp__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
    margin-bottom: 2.25rem;
  }

  .bp__head > div { max-width: 620px; }
  .bp__lead { color: var(--c-text-muted); margin: 0; }

  .bp__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.4rem;
  }

  .bp__media {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--c-sand-100);
  }

  .bp__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms ease;
  }

  .bp__card:hover .bp__media img { transform: scale(1.04); }

  .bp__body { padding: 1.15rem 1.25rem 1.4rem; display: grid; gap: 0.5rem; }

  .bp__body h3 { font-size: 1.35rem; margin: 0; }

  .bp__body h3 a {
    text-decoration: none;
    transition: color var(--transition);
  }

  .bp__body h3 a:hover { color: var(--c-red-500); }

  .bp__body p { margin: 0; color: var(--c-text-muted); font-size: 0.94rem; }

  .bp__more {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--c-red-500);
  }

  .bp__more:hover { color: var(--c-red-600); }

  @media (max-width: 900px) {
    .bp__grid { grid-template-columns: 1fr; }
  }
</style>
