---
import { path, type Locale } from '../i18n/config';
import { t } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const contactHref = `${path(locale, '/')}#kontakt`;
---

<section id="park-maszynowy" class="section machines">
  <div class="container">
    <header class="machines__head reveal">
      <p class="eyebrow">{dict.machines.eyebrow}</p>
      <h2>{dict.machines.title}</h2>
      <hr class="laser-line" />
      <p class="machines__lead">{dict.machines.lead}</p>
    </header>

    {dict.machines.groups.map((group, i) => (
      <div class="mgroup">
        <div class="mgroup__head reveal">
          <span class="mgroup__no">{String(i + 1).padStart(2, '0')}</span>
          <h3>{group.title}</h3>
          <span class="mgroup__rule"></span>
        </div>

        <div class="mgroup__grid">
          {group.machines.map((m) => (
            <article class="card machine reveal" data-wide={group.machines.length <= 2 ? '' : undefined}>
              <div class="machine__media">
                <img src={m.img} alt={m.imgAlt} loading="lazy" decoding="async" width="360" height="270" />
              </div>
              <div class="machine__body">
                <p class="machine__brand">{m.brand}</p>
                <h4 class="machine__name">{m.name}</h4>
                <ul class="machine__specs">
                  {m.specs.map((s) => (
                    <li>
                      <span class="machine__spec-label">{s.label}</span>
                      <span class="machine__spec-value">{s.value}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </article>
          ))}
        </div>
      </div>
    ))}

    <p class="machines__note reveal">
      {dict.machines.note}{' '}
      <a href={contactHref}>{dict.machines.cta}</a>
    </p>
  </div>
</section>

<style>
  .machines__head { max-width: 680px; margin-bottom: 3rem; }
  .machines__lead { color: var(--c-text-muted); }

  .mgroup + .mgroup { margin-top: 3rem; }

  .mgroup__head {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-bottom: 1.4rem;
  }

  .mgroup__no {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    color: var(--c-red-500);
  }

  .mgroup__head h3 {
    font-size: clamp(1.25rem, 2.2vw, 1.55rem);
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .mgroup__rule {
    flex: 1;
    height: 1px;
    background: var(--c-line);
  }

  .mgroup__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
    gap: 1.4rem;
  }

  .machine {
    display: flex;
    flex-direction: column;
  }

  /* Grupy z jedną lub dwiema maszynami: karty poziome na dwie kolumny siatki */
  .machine[data-wide] {
    grid-column: span 2;
    flex-direction: row;
  }

  .machine[data-wide] .machine__media {
    flex: 0 0 42%;
    aspect-ratio: auto;
    min-height: 200px;
    border-bottom: 0;
    border-right: 1px solid var(--c-line);
  }

  .machine[data-wide] .machine__body { flex: 1; }

  .machine__media {
    position: relative;
    flex: 0 0 auto;
    aspect-ratio: 4 / 3;
    background: var(--c-sand-100);
    border-bottom: 1px solid var(--c-line);
  }

  /* Zdjęcia maszyn mają różne proporcje — kadr trzyma stała ramka, obraz wpisuje się w nią */
  .machine__media img {
    position: absolute;
    inset: 0.9rem;
    width: calc(100% - 1.8rem);
    height: calc(100% - 1.8rem);
    object-fit: contain;
    mix-blend-mode: multiply;
    transition: transform 400ms ease;
  }

  .machine:hover .machine__media img { transform: scale(1.03); }

  .machine__body {
    padding: 1.1rem 1.25rem 1.35rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .machine__brand {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-text-muted);
    margin: 0 0 0.2rem;
  }

  .machine__name {
    font-size: 1.25rem;
    margin: 0 0 0.8rem;
  }

  .machine__specs {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--c-line);
  }

  .machine__specs li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.15rem 0.9rem;
    padding: 0.42rem 0;
    border-bottom: 1px dotted var(--c-line);
    font-size: 0.88rem;
  }

  .machine__spec-label {
    color: var(--c-text-muted);
    flex: 0 1 auto;
  }

  /* Wartość przenosi się do własnej linii, gdy nie mieści się obok etykiety */
  .machine__spec-value {
    flex: 1 1 9rem;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    text-align: right;
    color: var(--c-text);
  }

  .machines__note {
    margin: 3rem 0 0;
    padding: 1.1rem 1.3rem;
    border-left: 3px solid var(--c-red-500);
    background: var(--c-surface);
    border-block: 1px solid var(--c-line);
    border-right: 1px solid var(--c-line);
    color: var(--c-text-muted);
    max-width: 820px;
  }

  .machines__note a {
    color: var(--c-red-500);
    font-weight: 600;
    white-space: nowrap;
  }

  @media (max-width: 700px) {
    .machine[data-wide] {
      grid-column: span 1;
      flex-direction: column;
    }

    .machine[data-wide] .machine__media {
      flex: none;
      aspect-ratio: 4 / 3;
      border-bottom: 1px solid var(--c-line);
      border-right: 0;
    }
  }

  @media (max-width: 480px) {
    .machine__specs li { font-size: 0.84rem; }
  }
</style>
