---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { path, type Locale } from '../i18n/config';
import { t } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const home = path(locale, '/');

const links = [
  { href: `${home}#o-firmie`, label: dict.nav.about },
  { href: `${home}#uslugi`, label: dict.nav.services },
  { href: `${home}#park-maszynowy`, label: dict.nav.machines },
  { href: `${home}#dlaczego-my`, label: dict.nav.why },
  { href: `${home}#proces`, label: dict.nav.process },
  { href: path(locale, '/blog'), label: dict.nav.blog },
  { href: `${home}#kontakt`, label: dict.nav.contact },
];
---

<header class="header">
  <div class="container header__inner">
    <a href={home} class="brand" aria-label="Precimet OEM Manufacturing — strona główna">
      <img src={`${import.meta.env.BASE_URL}logo.png`} alt="Precimet" width="44" height="44" />
      <span class="brand__text">
        <strong>PRECIMET</strong>
        <span class="brand__sub">OEM Manufacturing</span>
      </span>
    </a>

    <button class="nav-toggle" aria-expanded="false" aria-controls="site-nav" aria-label="Menu">
      <span></span><span></span><span></span>
    </button>

    <nav id="site-nav" class="nav" aria-label="Main">
      <ul class="nav__list">
        {links.map((l) => (
          <li><a class="nav__link" href={l.href}>{l.label}</a></li>
        ))}
      </ul>
      <div class="nav__aside">
        <LanguageSwitcher variant="header" />
        <a class="btn btn--primary nav__cta" href={`${home}#kontakt`}>{dict.nav.cta}</a>
      </div>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(255 255 255 / 0.92);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--c-line);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 4.25rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
  }

  .brand img { border-radius: 50%; }

  .brand__text {
    display: flex;
    flex-direction: column;
    line-height: 1.05;
  }

  .brand__text strong {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--c-graphite-800);
  }

  .brand__sub {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--c-red-500);
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .nav__list {
    display: flex;
    align-items: center;
    gap: 1.05rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav__link {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--c-graphite-700);
    padding-block: 0.4rem;
    border-bottom: 2px solid transparent;
    transition: color var(--transition), border-color var(--transition);
  }

  .nav__link:hover {
    color: var(--c-red-500);
    border-color: var(--c-red-500);
  }

  .nav__aside {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .nav__cta { padding: 0.55rem 1.2rem; font-size: 0.95rem; }

  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: 0;
    padding: 0.5rem;
    cursor: pointer;
  }

  .nav-toggle span {
    width: 24px;
    height: 2px;
    background: var(--c-graphite-800);
    transition: transform var(--transition), opacity var(--transition);
  }

  @media (max-width: 1080px) {
    .nav-toggle { display: flex; }

    .nav {
      position: absolute;
      inset: 100% 0 auto 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      background: var(--c-surface);
      border-bottom: 1px solid var(--c-line);
      padding: 1rem 1.25rem 1.5rem;
      display: none;
    }

    .nav.is-open { display: flex; }

    .nav__list {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    .nav__link {
      display: block;
      padding: 0.8rem 0;
      border-bottom: 1px solid var(--c-line);
    }

    .nav__aside {
      margin-top: 1rem;
      justify-content: space-between;
    }
  }
</style>

<script>
  const toggle = document.querySelector('.nav-toggle');
  const nav = document.getElementById('site-nav');
  toggle?.addEventListener('click', () => {
    const open = nav?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', String(!!open));
  });
  nav?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) {
      nav.classList.remove('is-open');
      toggle?.setAttribute('aria-expanded', 'false');
    }
  });
</script>
