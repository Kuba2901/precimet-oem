---
import type { Locale } from '../i18n/config';
import { t } from '../i18n/ui';
import { path } from '../i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const f = dict.contact.form;
const info = dict.contact.info;
const map = dict.contact.map;
const thankYouPath = path(locale, locale === 'pl' ? '/dziekujemy' : locale === 'de' ? '/danke' : '/thank-you');
const privacyUrl = path(locale, locale === 'pl' ? '/polityka-prywatnosci' : locale === 'de' ? '/datenschutz' : '/privacy-policy');
---

<section id="kontakt" class="section section--dark contact">
  <div class="container contact__grid">
    <div class="contact__intro reveal">
      <p class="eyebrow">{dict.contact.eyebrow}</p>
      <h2>{dict.contact.title}</h2>
      <hr class="laser-line" />
      <p class="contact__lead">{dict.contact.lead}</p>

      <div class="contact__info">
        <h3>{info.title}</h3>
        <dl>
          <dt class="spec">{info.addressLabel}</dt>
          <dd>{info.address.split('\n').map((line) => <span>{line}<br /></span>)}</dd>
          <dt class="spec">{info.phoneLabel}</dt>
          <dd class="contact__phones">
            {info.phone.split('\n').filter((line) => line.trim() !== '').map((line) => {
              const isPhone = /^\+?[\d\s()-]+$/.test(line.trim());
              if (isPhone) return <a href={`tel:${line.replace(/\s/g, '')}`}>{line}</a>;
              return <span class="spec">{line}</span>;
            })}
          </dd>
          <dt class="spec">{info.emailLabel}</dt>
          <dd><a href={`mailto:${info.email}`}>{info.email}</a></dd>
          <dt class="spec">{info.hoursLabel}</dt>
          <dd>{info.hours}</dd>
        </dl>
        <p class="contact__note">{info.responseNote}</p>
        <a
          class="contact__directions"
          href="https://www.google.com/maps/dir/?api=1&destination=51.7854674,19.5891212"
          target="_blank"
          rel="noopener noreferrer"
        >{map.directions} &nearr;</a>
      </div>

      <div class="contact__map reveal">
        <iframe
          title="Precimet OEM Manufacturing — Łódź"
          src="https://www.openstreetmap.org/export/embed.html?bbox=19.5861,51.7824,19.5921,51.7884&layer=mapnik&marker=51.78547,19.58912"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          width="100%"
          height="300"
          style="border:0; border-radius: var(--radius);"
        ></iframe>
      </div>
    </div>

    <form
      class="contact__form reveal"
      method="POST"
      action="https://formsubmit.co/ajax/kubanenczakdev@gmail.com"
      enctype="multipart/form-data"
    >
      <input type="hidden" name="_captcha" value="false" />
      <div class="field-row">
        <label class="field">
          <span>{f.name}</span>
          <input type="text" name="name" required autocomplete="name" />
        </label>
        <label class="field">
          <span>{f.company}</span>
          <input type="text" name="company" autocomplete="organization" />
        </label>
      </div>

      <div class="field-row">
        <label class="field">
          <span>{f.email}</span>
          <input type="email" name="email" required autocomplete="email" />
        </label>
        <label class="field">
          <span>{f.phone}</span>
          <input type="tel" name="phone" autocomplete="tel" />
        </label>
      </div>

      <label class="field">
        <span>{f.message}</span>
        <textarea name="message" rows="6" required placeholder={f.messagePlaceholder}
        ></textarea>
      </label>

      <div class="field">
        <span>{f.file}</span>
        <label class="file-label">
          <input type="file" name="attachment" accept=".dxf,.dwg,.step,.stp,.iges,.igs,.pdf,.zip" />
        </label>
        <small class="spec">{f.fileHint}</small>
      </div>

      <label class="field field--consent">
        <input type="checkbox" name="consent" required />
        <span>{f.consent} <a href={privacyUrl} target="_blank" rel="noopener noreferrer">{locale === 'pl' ? 'Polityka prywatności' : locale === 'de' ? 'Datenschutzerklärung' : 'Privacy Policy'}</a>.</span>
      </label>

      <button class="btn btn--primary" type="submit">{f.submit}</button>
      <p class="spec contact__required">{f.note}</p>
    </form>
  </div>
</section>

<script define:vars={{ thankYouPath }}>
  const form = document.querySelector('.contact__form');
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = form.querySelector('button[type="submit"]');
      btn.disabled = true;
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
        });
        if (res.ok) {
          window.location.href = thankYouPath;
        } else {
          btn.disabled = false;
        }
      } catch {
        btn.disabled = false;
      }
    });
  }
</script>

<style>
  .contact__grid {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: start;
  }

  .contact__lead { color: var(--c-text-inverse-muted); }

  .contact__info { margin-top: 2rem; }

  .contact__info h3 { font-size: 1.25rem; margin-bottom: 0.8rem; }

  .contact__info dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.5rem 1.25rem;
    margin: 0;
  }

  .contact__info dt { align-self: start; padding-top: 0.15rem; color: var(--c-sand-500); }

  .contact__info dd { margin: 0; color: var(--c-text-inverse); }

  .contact__phones { display: grid; gap: 0.25rem; }

  .contact__phones a { display: block; width: fit-content; }

  .contact__phones .spec:not(:first-child) { margin-top: 0.6rem; }

  .contact__info a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid var(--c-steel-500);
    transition: color var(--transition), border-color var(--transition);
  }

  .contact__info a:hover { color: var(--c-sand-500); border-color: var(--c-sand-500); }

  .contact__note { margin-top: 1.2rem; color: var(--c-text-inverse-muted); font-size: 0.9rem; }

  .contact__form {
    background: var(--c-surface);
    color: var(--c-text);
    border-radius: var(--radius);
    padding: clamp(1.4rem, 3vw, 2.2rem);
    display: grid;
    gap: 1.1rem;
    box-shadow: 0 20px 50px rgb(0 0 0 / 0.3);
  }

  .field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.1rem;
  }

  .field { display: grid; gap: 0.35rem; }

  .field > span {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--c-graphite-700);
  }

  .field input[type='text'],
  .field input[type='email'],
  .field input[type='tel'],
  .field textarea {
    font: inherit;
    padding: 0.65rem 0.8rem;
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
    background: var(--c-bg);
    transition: border-color var(--transition);
  }

  .field input:focus,
  .field textarea:focus {
    border-color: var(--c-red-500);
    outline: none;
  }

  .field input[type='file'] { font-size: 0.85rem; }

  .file-label { display: block; }

  .field--consent {
    grid-template-columns: auto 1fr;
    align-items: start;
    gap: 0.6rem;
  }

  .field--consent span { font-weight: 400; font-size: 0.82rem; color: var(--c-text-muted); }

  .field--consent input { margin-top: 0.2rem; accent-color: var(--c-red-500); }

  .contact__required { margin: 0; }

  .contact__directions {
    display: inline-block;
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-sand-500);
    text-decoration: none;
    border-bottom: 1px solid var(--c-sand-500);
    transition: color var(--transition), border-color var(--transition);
  }

  .contact__directions:hover { color: #fff; border-color: #fff; }

  .contact__map { margin-top: 1.5rem; }

  @media (max-width: 860px) {
    .contact__grid { grid-template-columns: 1fr; }
    .field-row { grid-template-columns: 1fr; }
  }
</style>
