---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import {
  LOCALES,
  OG_LOCALES,
  path,
  localizedPath,
  stripLocale,
  type Locale,
} from '../i18n/config';
import { t } from '../i18n/ui';
import CookieConsent from '../components/CookieConsent.astro';
import { breadcrumbSchema, organizationSchema } from '../lib/schema';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  /** Ścieżka bez prefiksu językowego, np. '/blog' — używana do hreflang. */
  pagePath?: string;
  /**
   * Nadpisuje hreflang dla stron, których slug różni się między językami
   * (np. wpisy bloga). Klucz = język, wartość = ścieżka bez prefiksu językowego.
   * Brakujący język = brak wpisu hreflang, zamiast linku do nieistniejącej strony.
   */
  alternates?: Partial<Record<Locale, string>>;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: string;
  noindex?: boolean;
}

const { locale, title, description, pagePath, alternates, ogImage, ogImageAlt, ogType, noindex } =
  Astro.props;
const dict = t(locale);

const metaTitle = title ?? dict.seo.title;
const metaDescription = description ?? dict.seo.description;
const basePath = pagePath ?? stripLocale(Astro.url);
const site = Astro.site ?? new URL('https://oem.precimet.pl');
const canonical = new URL(path(locale, basePath), site).href;
const ogImg = ogImage ?? new URL(`${import.meta.env.BASE_URL}og-image.jpg`, site).href;
const ogAlt = ogImageAlt ?? metaTitle;

/* x-default wskazuje wersję polską — z mapy `alternates`, jeśli została podana. */
const xDefault = new URL(
  alternates ? path('pl', alternates.pl ?? basePath) : localizedPath('pl', basePath),
  site
).href;

/* Wariant markdown dla agentów AI: /about/ -> /about.md, / -> /index.md */
const markdownHref = new URL(
  basePath === '/'
    ? locale === 'pl'
      ? '/index.md'
      : `/${locale}/index.md`
    : `${path(locale, basePath).replace(/\/$/, '')}.md`,
  site
).href;

const jsonLd = organizationSchema(site, metaDescription);

/*
 * Okruszki wyliczane ze ścieżki. Etykiety z nawigacji tam, gdzie istnieją;
 * dla pozostałych stron (np. wpis bloga, polityka prywatności) bierzemy
 * początek tytułu, czyli to, co i tak jest nagłówkiem strony.
 */
const NAV_LABELS: Record<string, string> = {
  '/about': dict.nav.about,
  '/contact': dict.nav.contact,
  '/blog': dict.nav.blog,
};

const segments = basePath.split('/').filter(Boolean);
const crumbs = segments.map((_, i) => {
  const p = `/${segments.slice(0, i + 1).join('/')}`;
  return { label: NAV_LABELS[p] ?? metaTitle.split('—')[0].trim(), path: p };
});

const breadcrumbs = noindex ? null : breadcrumbSchema(site, locale, basePath, dict.nav.home, crumbs);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{metaTitle}</title>
    <meta name="description" content={metaDescription} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}logo.png`} />

    {/* hreflang — każda wersja językowa wskazuje właściwy przetłumaczony URL */}
    {LOCALES.map((l) =>
      alternates
        ? alternates[l] && (
            <link rel="alternate" hreflang={l} href={new URL(path(l, alternates[l]!), site).href} />
          )
        : <link rel="alternate" hreflang={l} href={new URL(localizedPath(l, basePath), site).href} />
    )}
    <link rel="alternate" hreflang="x-default" href={xDefault} />

    {/* Markdown content negotiation for AI agents (acceptmarkdown.com / RFC 8288) */}
    <link rel="alternate" type="text/markdown" href={markdownHref} />

    {/* Open Graph / Twitter */}
    <meta property="og:type" content={ogType ?? 'website'} />
    <meta property="og:site_name" content="Precimet OEM Manufacturing" />
    <meta property="og:title" content={metaTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImg} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta property="og:locale" content={OG_LOCALES[locale]} />
    {LOCALES.filter((l) => l !== locale).map((l) => (
      <meta property="og:locale:alternate" content={OG_LOCALES[l]} />
    ))}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={metaTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImg} />

    {/* Fonty */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=IBM+Plex+Mono:wght@400;500&family=Inter:wght@400;500;600&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {breadcrumbs && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbs)} />
    )}
  </head>
  <body>
    <Header locale={locale} />
    <main>
      <slot />
    </main>
    <Footer locale={locale} />
    <CookieConsent locale={locale} />

    {/* Subtelne animacje wejścia sekcji */}
    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              observer.unobserve(e.target);
            }
          }
        },
        { threshold: 0.12 }
      );
      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
