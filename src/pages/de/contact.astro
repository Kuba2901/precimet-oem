---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactSection from '../../components/Contact.astro';

const locale = 'de' as const;

const contactJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Kontakt & Preisanfrage (RFQ) — Precimet OEM Manufacturing',
  description: 'Kontaktieren Sie Precimet OEM Manufacturing für Angebote zu Laserschneiden, CNC-Abkanten, Schweißen und Baugruppenfertigung.',
  mainEntity: {
    '@type': 'LocalBusiness',
    name: 'PRECIMET H.C.E. Sp. z o.o.',
    image: 'https://oem.precimet.pl/logo.png',
    telephone: '+48 422 080 411',
    email: 'produkcja@precimet.pl',
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'ul. Pomorska 555',
      addressLocality: 'Łódź',
      postalCode: '92-735',
      addressCountry: 'PL',
    },
    openingHoursSpecification: {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '07:00',
      closes: '15:00',
    },
  },
};
---

<BaseLayout
  locale={locale}
  title="Kontakt & Preisanfrage — Precimet OEM Manufacturing | Angebot anfordern"
  description="Kontaktieren Sie Precimet OEM Manufacturing in Polen. Senden Sie Ihre CAD-Dateien (.STEP, .DXF) für eine schnelle technische Kalkulation und Angebotserstellung."
  pagePath="/contact"
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(contactJsonLd)} />

  <ContactSection locale={locale} />
</BaseLayout>
