---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactSection from '../../components/Contact.astro';
import { pageEntitySchema } from '../../lib/schema';

const locale = 'de' as const;

const contactJsonLd = pageEntitySchema(
  Astro.site ?? new URL('https://oem.precimet.pl'),
  'ContactPage',
  'Kontakt & Preisanfrage (RFQ) — Precimet OEM Manufacturing',
  'Kontaktieren Sie Precimet OEM Manufacturing für Angebote zu Laserschneiden, CNC-Abkanten, Schweißen und Baugruppenfertigung.'
);
---

<BaseLayout
  locale={locale}
  title="Angebotsanfrage (RFQ) — Precimet OEM, Polen"
  description="Kontaktieren Sie Precimet OEM Manufacturing in Polen. Senden Sie Ihre CAD-Dateien (.STEP, .DXF) für eine schnelle technische Kalkulation und Angebotserstellung."
  pagePath="/contact"
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(contactJsonLd)} />

  <ContactSection locale={locale} as="h1" />
</BaseLayout>
