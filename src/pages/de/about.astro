---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { path } from '../../i18n/config';
import { pageEntitySchema } from '../../lib/schema';

const locale = 'de' as const;

const aboutJsonLd = pageEntitySchema(
  Astro.site ?? new URL('https://oem.precimet.pl'),
  'AboutPage',
  'Über uns — Precimet OEM Manufacturing',
  'Unternehmensprofil, CNC-Fertigungskapazitäten, Maschinenpark und ISO 9001:2015 Qualitätsstandards von PRECIMET H.C.E. Sp. z o.o.'
);
---

<BaseLayout
  locale={locale}
  title="Über Precimet OEM Manufacturing — Polen"
  description="Über 30 Jahre Blechbearbeitung, ISO 9001:2015 zertifiziert, eigener CNC-Maschinenpark und Serienfertigung in Łódź, Polen."
  pagePath="/about"
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(aboutJsonLd)} />

  <section class="section about-page">
    <div class="container">
      <header class="about-page__head reveal">
        <p class="eyebrow">Über Precimet</p>
        <h1>Über Precimet OEM Manufacturing</h1>
        <hr class="laser-line" />
        <p class="about-page__lead">
          Ihr zuverlässiger europäischer Partner für die industrielle Lohnfertigung von Blechteilen, Schweißbaugruppen und Präzisionsteilen für anspruchsvolle Kunden in der gesamten EU.
        </p>
      </header>

      <div class="about-page__grid">
        <div class="about-page__main prose reveal">
          <h2>1. Über 30 Jahre Erfahrung in der Metallbearbeitung</h2>
          <p>
            <strong>PRECIMET H.C.E. Sp. z o.o.</strong> ist ein Produktionsbetrieb mit Sitz in Łódź, Polen. Hinter dem Unternehmen stehen über 30 Jahre Erfahrung in der Metallbearbeitung — heute schneiden, kanten, schweißen, zerspanen und montieren wir Metallteile auf unserem eigenen Maschinenpark.
          </p>
          <p>
            Wir fertigen u. a. für Maschinen- und Anlagenbauer, Automatisierungsintegratoren und OEM-Unternehmen, darunter Kunden aus Lebensmittelindustrie, Energiewirtschaft, Transport und Logistik, Bau, Metallmöbelbau und Agrartechnik. Bisher haben wir über 3,5 Millionen Teile gefertigt — vom Einzelprototyp bis zur Serie.
          </p>

          <h2>2. Ganzheitliche Fertigungskette aus einer Hand</h2>
          <p>
            Ein Partner trägt die Verantwortung für den gesamten Prozess — von Dokumentation und CAD/CAM über Schneiden, Biegen, Schweißen und CNC-Bearbeitung bis zur Montage fertiger Baugruppen:
          </p>
          <ul>
            <li><strong>Laserschneiden:</strong> Mazak Nexus Optiplex 2D, Faserlaser 4 kW, Tafelformat bis 3000 × 1500 mm. Baustahl sowie Edelstahl und säurebeständiger Stahl bis 20 mm, Aluminium bis 10 mm, Messing und Kupfer.</li>
            <li><strong>Abkanten:</strong> servoelektrische Abkantpresse von Safan — Biegelänge bis 3000 mm, Presskraft bis 160 t.</li>
            <li><strong>CNC-Zerspanung:</strong> Bearbeitungszentren Doosan DNM-750L (2160 × 762 × 650 mm) und Avia VMC 650 (650 × 540 × 620 mm); Drehmaschinen Romi 510 (bis 1500 mm, ⌀255 mm) und Doosan Lynx 300M (bis 712 mm, ⌀254 mm).</li>
            <li><strong>Schweißen:</strong> Schweißroboter OTC Daihen (Schweißbereich 2000 × 1000 × 400 mm) sowie manuelles MIG/MAG- und WIG-Schweißen.</li>
            <li><strong>Profile und Rohre:</strong> CNC-Säge IMET mit automatischem Gehrungsschnitt −60° / 0 / +60° und Rohrbiegemaschine SOCO für ⌀25, ⌀32 und ⌀50 mm.</li>
            <li><strong>Montage:</strong> mechanische und Elektromontage — von Kabelsätzen bis zu kompletten Schaltschränken und Modulen.</li>
          </ul>

          <h2>3. Qualitätsmanagement und ISO 9001:2015</h2>
          <p>
            Seit 2015 arbeiten wir mit einem zertifizierten Qualitätsmanagementsystem nach <strong>ISO 9001:2015</strong>. Jeder Auftrag durchläuft Eingangs-, Zwischen- und Endprüfung; die geforderte Qualitätsdokumentation und Materialzeugnisse liefern wir mit.
          </p>

          <h2>4. Unternehmensdaten und Handelsregister</h2>
          <div class="legal-box">
            <dl class="legal-box__grid">
              <div><dt>Rechtsform:</dt><dd>PRECIMET H.C.E. Sp. z o.o.</dd></div>
              <div><dt>Firmensitz:</dt><dd>ul. Pomorska 555, 92-735 Łódź, Polen</dd></div>
              <div><dt>Handelsregister (KRS):</dt><dd>0000587797</dd></div>
              <div><dt>Umsatzsteuer-ID (USt-IdNr.):</dt><dd>PL7282804918</dd></div>
              <div><dt>Statistische Nummer (REGON):</dt><dd>363114171</dd></div>
              <div><dt>Stammkapital:</dt><dd>101.000,00 PLN</dd></div>
            </dl>
          </div>
        </div>

        <aside class="about-page__sidebar reveal">
          <div class="info-card">
            <h3>Fakten im Überblick</h3>
            <dl class="facts-list">
              <div class="fact-item">
                <dt>Branchenerfahrung</dt>
                <dd>30+ Jahre</dd>
              </div>
              <div class="fact-item">
                <dt>Qualitätszertifikat</dt>
                <dd>ISO 9001:2015</dd>
              </div>
              <div class="fact-item">
                <dt>Abkanten max.</dt>
                <dd>160 t / 3000 mm</dd>
              </div>
              <div class="fact-item">
                <dt>Liefergebiet</dt>
                <dd>Polen & Europa</dd>
              </div>
            </dl>
          </div>

          <div class="info-card info-card--cta">
            <h3>OEM-Partner gesucht?</h3>
            <p>Senden Sie uns Ihre CAD-Daten (.STEP, .DXF) — wir erstellen Ihnen innerhalb von 1–2 Werktagen ein Angebot.</p>
            <a href={path(locale, '/contact')} class="btn btn--primary">Kontakt aufnehmen</a>
          </div>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-page {
    padding-block: var(--section-y);
  }

  .about-page__head {
    max-width: 50rem;
    margin-bottom: 3rem;
  }

  .about-page__lead {
    font-size: 1.2rem;
    color: var(--c-text-muted);
    line-height: 1.6;
    margin-top: 1rem;
  }

  .about-page__grid {
    display: grid;
    grid-template-columns: 1fr 20rem;
    gap: 3.5rem;
    align-items: start;
  }

  .about-page__main h2 {
    margin-top: 2.2rem;
    font-size: clamp(1.4rem, 2.5vw, 1.8rem);
    color: var(--c-graphite-800);
  }

  .about-page__main p {
    margin-bottom: 1.1rem;
    line-height: 1.7;
    color: var(--c-text);
  }

  .about-page__main ul {
    padding-left: 1.25rem;
    margin-bottom: 1.5rem;
    display: grid;
    gap: 0.6rem;
  }

  .legal-box {
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
    padding: 1.5rem;
    margin-top: 1.5rem;
  }

  .legal-box__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin: 0;
  }

  .legal-box dt {
    font-size: 0.8rem;
    color: var(--c-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .legal-box dd {
    margin: 0.2rem 0 0;
    font-weight: 600;
    color: var(--c-graphite-800);
  }

  .about-page__sidebar {
    display: grid;
    gap: 1.5rem;
  }

  .info-card {
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
    padding: 1.5rem;
  }

  .info-card h3 {
    font-size: 1.15rem;
    margin-bottom: 1rem;
  }

  .facts-list {
    display: grid;
    gap: 1rem;
    margin: 0;
  }

  .fact-item dt {
    font-size: 0.82rem;
    color: var(--c-text-muted);
  }

  .fact-item dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--c-red-500);
  }

  .info-card--cta {
    background: var(--c-graphite-900);
    color: var(--c-text-inverse);
    border-color: var(--c-graphite-700);
  }

  .info-card--cta h3 {
    color: var(--c-text-inverse);
  }

  .info-card--cta p {
    color: var(--c-steel-300);
    font-size: 0.92rem;
    margin-bottom: 1.2rem;
  }

  @media (max-width: 960px) {
    .about-page__grid {
      grid-template-columns: 1fr;
    }

    .legal-box__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
