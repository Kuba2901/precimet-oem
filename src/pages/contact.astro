---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactSection from '../components/Contact.astro';
import { pageEntitySchema } from '../lib/schema';

const locale = 'pl' as const;

const contactJsonLd = pageEntitySchema(
  Astro.site ?? new URL('https://oem.precimet.pl'),
  'ContactPage',
  'Kontakt & Zapytania Ofertowe — Precimet OEM Manufacturing',
  'Skontaktuj się z Precimet OEM Manufacturing w sprawie wyceny cięcia laserowego, gięcia CNC, spawania i produkcji seryjnej wyrobów z metalu.'
);
---

<BaseLayout
  locale={locale}
  title="Zapytanie ofertowe (RFQ) — Precimet OEM, Łódź"
  description="Skontaktuj się z działem produkcji Precimet w Łodzi. Prześlij pliki CAD (.STEP, .DXF) do bezpłatnej wyceny cięcia laserowego, gięcia CNC i konstrukcji spawanych."
  pagePath="/contact"
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(contactJsonLd)} />

  <ContactSection locale={locale} as="h1" />
</BaseLayout>
