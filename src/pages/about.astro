---
import BaseLayout from '../layouts/BaseLayout.astro';
import { path } from '../i18n/config';
import { pageEntitySchema } from '../lib/schema';

const locale = 'pl' as const;

const aboutJsonLd = pageEntitySchema(
  Astro.site ?? new URL('https://oem.precimet.pl'),
  'AboutPage',
  'O firmie — Precimet OEM Manufacturing',
  'Historia, możliwości produkcyjne, park maszynowy i certyfikaty jakości ISO 9001:2015 PRECIMET H.C.E. Sp. z o.o.'
);
---

<BaseLayout
  locale={locale}
  title="O firmie — Precimet OEM Manufacturing, Łódź"
  description="Ponad 30 lat w obróbce metali, ISO 9001:2015, własny park maszynowy CNC i produkcja seryjna w Łodzi. Poznaj zaplecze Precimet OEM Manufacturing."
  pagePath="/about"
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(aboutJsonLd)} />

  <section class="section about-page">
    <div class="container">
      <header class="about-page__head reveal">
        <p class="eyebrow">Poznaj Precimet</p>
        <h1>O firmie Precimet OEM Manufacturing</h1>
        <hr class="laser-line" />
        <p class="about-page__lead">
          Jesteśmy doświadczonym polskim partnerem w seryjnej produkcji kontraktowej wyrobów z blach, konstrukcji spawanych i komponentów precyzyjnych dla przemysłu w całej Europie.
        </p>
      </header>

      <div class="about-page__grid">
        <div class="about-page__main prose reveal">
          <h2>1. Ponad 30 lat doświadczenia w obróbce metali</h2>
          <p>
            <strong>PRECIMET H.C.E. Sp. z o.o.</strong> to zakład produkcyjny z siedzibą w Łodzi przy ul. Pomorskiej 555. Za firmą stoi ponad 30 lat doświadczenia w obróbce metali — dziś tniemy laserem, gniemy, spawamy, obrabiamy CNC i montujemy na własnym parku maszynowym.
          </p>
          <p>
            Współpracujemy z producentami maszyn i urządzeń, integratorami automatyki oraz firmami rozwijającymi własne produkty — m.in. z branży spożywczej, transportu i logistyki, mebli metalowych i budownictwa. Wyprodukowaliśmy już ponad 3,5 miliona części, od pojedynczych prototypów po powtarzalne serie.
          </p>

          <h2>2. Kompleksowy łańcuch produkcyjny w jednym miejscu</h2>
          <p>
            Jeden partner odpowiada za cały proces — od przygotowania dokumentacji i programów CAD/CAM, przez cięcie, gięcie, spawanie i obróbkę CNC, aż po montaż gotowych zespołów.
          </p>
          <ul>
            <li><strong>Cięcie laserowe:</strong> Mazak Nexus Optiplex 2D, laser fiber 4 kW, arkusz do 3000 × 1500 mm. Blachy czarne oraz nierdzewne i kwasoodporne do 20 mm, aluminium do 10 mm, mosiądz i miedź.</li>
            <li><strong>Gięcie blach:</strong> serwoelektryczna prasa krawędziowa Safan — długość gięcia do 3000 mm, nacisk do 160 ton.</li>
            <li><strong>Obróbka CNC:</strong> centra frezarskie Doosan DNM-750L (2160 × 762 × 650 mm) i Avia VMC 650 (650 × 540 × 620 mm); tokarki Romi 510 (do 1500 mm, ⌀255 mm) i Doosan Lynx 300M (do 712 mm, ⌀254 mm).</li>
            <li><strong>Spawanie:</strong> robot spawalniczy OTC Daihen (zakres 2000 × 1000 × 400 mm) oraz spawanie ręczne MIG/MAG i TIG.</li>
            <li><strong>Profile i rury:</strong> piła CNC IMET z automatycznym ukosowaniem −60° / 0 / +60° oraz giętarka SOCO do rur ⌀25, ⌀32 i ⌀50 mm.</li>
            <li><strong>Montaż:</strong> montaż mechaniczny i elektryczny zespołów — od wiązek po kompletne szafy i moduły.</li>
          </ul>

          <h2>3. Kontrola jakości i certyfikat ISO 9001:2015</h2>
          <p>
            Od 2015 roku pracujemy w certyfikowanym systemie zarządzania jakością zgodnym z normą <strong>ISO 9001:2015</strong>. Prowadzimy kontrolę materiałów, kontrolę międzyoperacyjną i końcową, a na życzenie dostarczamy uzgodnioną dokumentację jakościową i świadectwa materiałowe.
          </p>

          <h2>4. Dane rejestrowe i formalne</h2>
          <div class="legal-box">
            <dl class="legal-box__grid">
              <div><dt>Nazwa prawna:</dt><dd>PRECIMET H.C.E. Sp. z o.o.</dd></div>
              <div><dt>Siedziba:</dt><dd>ul. Pomorska 555, 92-735 Łódź, Polska</dd></div>
              <div><dt>KRS:</dt><dd>0000587797 (Sąd Rejonowy dla Łodzi-Śródmieścia)</dd></div>
              <div><dt>NIP (VAT UE):</dt><dd>PL7282804918</dd></div>
              <div><dt>REGON:</dt><dd>363114171</dd></div>
              <div><dt>Kapitał zakładowy:</dt><dd>101.000,00 PLN</dd></div>
            </dl>
          </div>
        </div>

        <aside class="about-page__sidebar reveal">
          <div class="info-card">
            <h3>Kluczowe fakty</h3>
            <dl class="facts-list">
              <div class="fact-item">
                <dt>Doświadczenie</dt>
                <dd>30+ lat</dd>
              </div>
              <div class="fact-item">
                <dt>Certyfikat jakości</dt>
                <dd>ISO 9001:2015</dd>
              </div>
              <div class="fact-item">
                <dt>Maks. gięcie</dt>
                <dd>160 t / 3000 mm</dd>
              </div>
              <div class="fact-item">
                <dt>Obszar dostaw</dt>
                <dd>Polska i Europa</dd>
              </div>
            </dl>
          </div>

          <div class="info-card info-card--cta">
            <h3>Szukasz partnera OEM?</h3>
            <p>Prześlij pliki CAD (.STEP, .DXF) — przygotujemy ofertę techniczno-cenową w ciągu 1–2 dni roboczych.</p>
            <a href={path(locale, '/contact')} class="btn btn--primary">Skontaktuj się z nami</a>
          </div>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-page {
    padding-block: var(--section-y);
  }

  .about-page__head {
    max-width: 50rem;
    margin-bottom: 3rem;
  }

  .about-page__lead {
    font-size: 1.2rem;
    color: var(--c-text-muted);
    line-height: 1.6;
    margin-top: 1rem;
  }

  .about-page__grid {
    display: grid;
    grid-template-columns: 1fr 20rem;
    gap: 3.5rem;
    align-items: start;
  }

  .about-page__main h2 {
    margin-top: 2.2rem;
    font-size: clamp(1.4rem, 2.5vw, 1.8rem);
    color: var(--c-graphite-800);
  }

  .about-page__main p {
    margin-bottom: 1.1rem;
    line-height: 1.7;
    color: var(--c-text);
  }

  .about-page__main ul {
    padding-left: 1.25rem;
    margin-bottom: 1.5rem;
    display: grid;
    gap: 0.6rem;
  }

  .legal-box {
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
    padding: 1.5rem;
    margin-top: 1.5rem;
  }

  .legal-box__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin: 0;
  }

  .legal-box dt {
    font-size: 0.8rem;
    color: var(--c-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .legal-box dd {
    margin: 0.2rem 0 0;
    font-weight: 600;
    color: var(--c-graphite-800);
  }

  .about-page__sidebar {
    display: grid;
    gap: 1.5rem;
  }

  .info-card {
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
    padding: 1.5rem;
  }

  .info-card h3 {
    font-size: 1.15rem;
    margin-bottom: 1rem;
  }

  .facts-list {
    display: grid;
    gap: 1rem;
    margin: 0;
  }

  .fact-item dt {
    font-size: 0.82rem;
    color: var(--c-text-muted);
  }

  .fact-item dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--c-red-500);
  }

  .info-card--cta {
    background: var(--c-graphite-900);
    color: var(--c-text-inverse);
    border-color: var(--c-graphite-700);
  }

  .info-card--cta h3 {
    color: var(--c-text-inverse);
  }

  .info-card--cta p {
    color: var(--c-steel-300);
    font-size: 0.92rem;
    margin-bottom: 1.2rem;
  }

  @media (max-width: 960px) {
    .about-page__grid {
      grid-template-columns: 1fr;
    }

    .legal-box__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
