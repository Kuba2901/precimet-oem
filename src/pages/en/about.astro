---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { path } from '../../i18n/config';
import { pageEntitySchema } from '../../lib/schema';

const locale = 'en' as const;

const aboutJsonLd = pageEntitySchema(
  Astro.site ?? new URL('https://oem.precimet.pl'),
  'AboutPage',
  'About Us — Precimet OEM Manufacturing',
  'Company background, CNC manufacturing capabilities, machine park, and ISO 9001:2015 quality standards of PRECIMET H.C.E. Sp. z o.o.'
);
---

<BaseLayout
  locale={locale}
  title="About Precimet OEM Manufacturing — Poland"
  description="Over 30 years of metalworking, ISO 9001:2015 certified, in-house CNC machinery and turnkey serial production in Łódź, Poland."
  pagePath="/about"
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(aboutJsonLd)} />

  <section class="section about-page">
    <div class="container">
      <header class="about-page__head reveal">
        <p class="eyebrow">About Precimet</p>
        <h1>About Precimet OEM Manufacturing</h1>
        <hr class="laser-line" />
        <p class="about-page__lead">
          Your trusted European contract manufacturing partner for precision sheet metal components, robotic welded assemblies, and machined metal parts.
        </p>
      </header>

      <div class="about-page__grid">
        <div class="about-page__main prose reveal">
          <h2>1. Over 30 Years of Metalworking Experience</h2>
          <p>
            <strong>PRECIMET H.C.E. Sp. z o.o.</strong> is a contract manufacturing facility in Łódź, central Poland. The company is built on more than 30 years of metalworking experience — today we laser cut, bend, weld, machine and assemble metal parts on our own machine park.
          </p>
          <p>
            We work for machine and equipment builders, automation and robotics integrators and OEM companies, including customers in the food, energy, transport and logistics, construction, metal furniture and agricultural sectors. We have manufactured more than 3.5 million parts, from one-off prototypes to repeatable series.
          </p>

          <h2>2. The Complete Fabrication Chain Under One Roof</h2>
          <p>
            One partner takes responsibility for the whole process — from documentation and CAD/CAM engineering through cutting, bending, welding and CNC machining to the assembly of finished units:
          </p>
          <ul>
            <li><strong>Laser cutting:</strong> Mazak Nexus Optiplex 2D, 4 kW fibre laser, sheets up to 3000 × 1500 mm. Mild steel and stainless / acid-resistant steel up to 20 mm, aluminium up to 10 mm, brass and copper.</li>
            <li><strong>Sheet metal bending:</strong> Safan servo-electric press brake — bending length up to 3000 mm, up to 160 t.</li>
            <li><strong>CNC machining:</strong> Doosan DNM-750L (2160 × 762 × 650 mm) and Avia VMC 650 (650 × 540 × 620 mm) machining centres; Romi 510 (up to 1500 mm, ⌀255 mm) and Doosan Lynx 300M (up to 712 mm, ⌀254 mm) lathes.</li>
            <li><strong>Welding:</strong> OTC Daihen welding robot (2000 × 1000 × 400 mm envelope) plus manual MIG/MAG and TIG welding.</li>
            <li><strong>Profiles and tubes:</strong> IMET CNC saw with automatic −60° / 0 / +60° mitre cutting and a SOCO tube bender for ⌀25, ⌀32 and ⌀50 mm tubes.</li>
            <li><strong>Assembly:</strong> mechanical and electrical assembly — from harnesses to complete cabinets and modules.</li>
          </ul>

          <h2>3. Quality Assurance & ISO 9001:2015 Certification</h2>
          <p>
            Since 2015 we have operated a certified quality management system compliant with <strong>ISO 9001:2015</strong>. Every order goes through incoming, in-process and final inspection, and we supply the quality documentation and material certificates your order requires.
          </p>

          <h2>4. Legal Registration & Entity Details</h2>
          <div class="legal-box">
            <dl class="legal-box__grid">
              <div><dt>Legal Entity Name:</dt><dd>PRECIMET H.C.E. Sp. z o.o.</dd></div>
              <div><dt>Registered Office:</dt><dd>ul. Pomorska 555, 92-735 Łódź, Poland</dd></div>
              <div><dt>National Court Register (KRS):</dt><dd>0000587797</dd></div>
              <div><dt>Tax Number (NIP / EU VAT):</dt><dd>PL7282804918</dd></div>
              <div><dt>Statistical ID (REGON):</dt><dd>363114171</dd></div>
              <div><dt>Share Capital:</dt><dd>101,000.00 PLN</dd></div>
            </dl>
          </div>
        </div>

        <aside class="about-page__sidebar reveal">
          <div class="info-card">
            <h3>Key Facts</h3>
            <dl class="facts-list">
              <div class="fact-item">
                <dt>Industry Experience</dt>
                <dd>30+ Years</dd>
              </div>
              <div class="fact-item">
                <dt>Quality Management</dt>
                <dd>ISO 9001:2015</dd>
              </div>
              <div class="fact-item">
                <dt>Max Bending Capacity</dt>
                <dd>160 t / 3000 mm</dd>
              </div>
              <div class="fact-item">
                <dt>Delivery Reach</dt>
                <dd>Poland & Europe</dd>
              </div>
            </dl>
          </div>

          <div class="info-card info-card--cta">
            <h3>Looking for an OEM Partner?</h3>
            <p>Send your CAD files (.STEP, .DXF) — we will send you a detailed quotation within 1–2 business days.</p>
            <a href={path(locale, '/contact')} class="btn btn--primary">Get in Touch</a>
          </div>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-page {
    padding-block: var(--section-y);
  }

  .about-page__head {
    max-width: 50rem;
    margin-bottom: 3rem;
  }

  .about-page__lead {
    font-size: 1.2rem;
    color: var(--c-text-muted);
    line-height: 1.6;
    margin-top: 1rem;
  }

  .about-page__grid {
    display: grid;
    grid-template-columns: 1fr 20rem;
    gap: 3.5rem;
    align-items: start;
  }

  .about-page__main h2 {
    margin-top: 2.2rem;
    font-size: clamp(1.4rem, 2.5vw, 1.8rem);
    color: var(--c-graphite-800);
  }

  .about-page__main p {
    margin-bottom: 1.1rem;
    line-height: 1.7;
    color: var(--c-text);
  }

  .about-page__main ul {
    padding-left: 1.25rem;
    margin-bottom: 1.5rem;
    display: grid;
    gap: 0.6rem;
  }

  .legal-box {
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
    padding: 1.5rem;
    margin-top: 1.5rem;
  }

  .legal-box__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin: 0;
  }

  .legal-box dt {
    font-size: 0.8rem;
    color: var(--c-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .legal-box dd {
    margin: 0.2rem 0 0;
    font-weight: 600;
    color: var(--c-graphite-800);
  }

  .about-page__sidebar {
    display: grid;
    gap: 1.5rem;
  }

  .info-card {
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
    padding: 1.5rem;
  }

  .info-card h3 {
    font-size: 1.15rem;
    margin-bottom: 1rem;
  }

  .facts-list {
    display: grid;
    gap: 1rem;
    margin: 0;
  }

  .fact-item dt {
    font-size: 0.82rem;
    color: var(--c-text-muted);
  }

  .fact-item dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--c-red-500);
  }

  .info-card--cta {
    background: var(--c-graphite-900);
    color: var(--c-text-inverse);
    border-color: var(--c-graphite-700);
  }

  .info-card--cta h3 {
    color: var(--c-text-inverse);
  }

  .info-card--cta p {
    color: var(--c-steel-300);
    font-size: 0.92rem;
    margin-bottom: 1.2rem;
  }

  @media (max-width: 960px) {
    .about-page__grid {
      grid-template-columns: 1fr;
    }

    .legal-box__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
