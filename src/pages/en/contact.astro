---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactSection from '../../components/Contact.astro';
import { pageEntitySchema } from '../../lib/schema';

const locale = 'en' as const;

const contactJsonLd = pageEntitySchema(
  Astro.site ?? new URL('https://oem.precimet.pl'),
  'ContactPage',
  'Contact & RFQ — Precimet OEM Manufacturing',
  'Get in touch with Precimet OEM Manufacturing for contract metal fabrication, laser cutting, CNC bending, and serial OEM production.'
);
---

<BaseLayout
  locale={locale}
  title="Contact & RFQ — Precimet OEM Manufacturing"
  description="Contact Precimet OEM Manufacturing in Łódź, Poland. Submit CAD drawings (.STEP, .DXF) for rapid quotation on laser cutting, CNC bending, and welding."
  pagePath="/contact"
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(contactJsonLd)} />

  <ContactSection locale={locale} as="h1" />
</BaseLayout>
